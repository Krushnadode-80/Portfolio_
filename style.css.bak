/* GENERAL */

@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap");

* {
  margin: 0;
  padding: 0;
   box-sizing: border-box;
}

body {
  font-family: "Poppins", sans-serif;
}

html {
  scroll-behavior: smooth;
}

html, body {
  overflow-x: hidden;
}


p {
  color: rgb(85, 85, 85);
}

/* TRANSITION */

a,
.btn {
  transition: all 300ms ease;
}

/* DESKTOP NAV */

nav,
.nav-links {
  display: flex;
}

nav {
  justify-content: space-around;
  align-items: center;
  height: 17vh;
}

.nav-links {
  gap: 2rem;
  list-style: none;
  font-size: 1.5rem;
}

a {
  color: black;
  text-decoration: none;
  text-decoration-color: white;
}

a:hover {
  color: grey;
  text-decoration: underline;
  text-underline-offset: 1rem;
  text-decoration-color: rgb(181, 181, 181);
}

.logo {
  font-size: 2rem;
}

.logo:hover {
  cursor: default;
}

/* HAMBURGER MENU */

#hamburger-nav {
  display: none;
}

.hamburger-menu {
  position: relative;
  display: inline-block;
}

.hamburger-icon {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 24px;
  width: 30px;
  cursor: pointer;
}

.hamburger-icon span {
  width: 100%;
  height: 2px;
  background-color: black;
  transition: all 0.3 ease-in-out;
}

.menu-links {
  position: absolute;
  top: 100%;
  right: 0;
  width: 220px;
  background: white;
  border-radius: 1rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);

  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: all 0.3s ease;
}

.menu-links li {
  list-style: none;
}

.menu-links a {
  display: block;
  padding: 12px 18px;
  font-size: 1.2rem;
  color: var(--text-dark);
}

.menu-links a:hover {
  background: var(--bg-light);
  color: var(--primary);
}

/* OPEN STATE */
.menu-links.open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}


.hamburger-icon.open span:first-child {
  transform: rotate(45deg) translate(10px, 5px);
}

.hamburger-icon.open span:nth-child(2) {
  opacity: 0;
}

.hamburger-icon.open span:last-child {
  transform: rotate(-45deg) translate(10px, -5px);
}

.hamburger-icon span:first-child {
  transform: none;
}

.hamburger-icon span:first-child {
  opacity: 1;
}

.hamburger-icon span:first-child {
  transform: none;
}

/* SECTIONS */

section {
  padding: 3rem 1.5rem;
  margin: 2rem auto;
  max-width: 1200px;
  border-radius: 1.5rem;
  box-sizing: border-box;
}


.section-container {
  display: flex;
}

/* PROFILE SECTION */


#profile {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 3rem;
  margin: 3rem auto;
  flex-wrap: wrap;
  height: auto;
}

.section__pic-container {
  width: 280px;
  height: 280px; 
  border-radius: 50%;
  overflow: hidden;
  background: white;
  flex-shrink: 0;
  margin: 0 auto;
}

.section__pic-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.section__text {
  align-self: center;
  text-align: center;
}

.section__text p {
  font-weight: 600;
}

.section__text__p1 {
  text-align: center;
}

.section__text__p2 {
  font-size: 1.75rem;
  margin-bottom: 1rem;
}

.title {
  font-size: 3rem;
  text-align: center;
}

#socials-container {
  display: flex;
  justify-content: center;
  margin-top: 1rem;
  gap: 1rem;
}

/* ICONS */

.icon {
  cursor: pointer;
  height: 2rem;
}

/* BUTTONS */

/* centralize buttons in any container and allow them to wrap if there are
   more than will fit on one line (e.g. two project buttons). the
   `align-items` ensures vertical centering when buttons wrap or when the
   container is taller than the buttons. */
.btn-container {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.btn {
  font-weight: 600;
  transition: all 300ms ease;
  padding: 1rem;
  width: 8rem;
  border-radius: 2rem;
}

.btn-color-1,
.btn-color-2 {
  border: rgb(53, 53, 53) 0.1rem solid;
}

.btn-color-1:hover,
.btn-color-2:hover {
  cursor: pointer;
}

.btn-color-1,
.btn-color-2:hover {
  background: rgb(53, 53, 53);
  color: white;
}

.btn-color-1:hover {
  background: rgb(0, 0, 0);
}

.btn-color-2 {
  background: none;
}

.btn-color-2:hover {
  border: rgb(255, 255, 255) 0.1rem solid;
}

/* extra gap rule removed; main rule above handles all spacing */

/* ABOUT SECTION (removed) */
/* styles for the About section were removed since the section is no longer in use */

/* ensure about text and title stack nicely on smaller screens */
@media (max-width: 768px) {
  .about-title {
    font-size: 28px;
    text-align: center;
  }
  .about-text {
    font-size: 14px;
    text-align: center;
    padding: 0 1rem;
  }
}

.arrow {
  position: absolute;
  right: -5rem;
  bottom: 2.5rem;
}

/* RESUME SECTION */
.resume-section {
  background: #f7f7f7;
  padding: 90px 20px;
}

.resume-container {
  max-width: 1100px;
  margin: 0 auto;
  text-align: center;
}

.resume-subtitle {
  color: #7a7a7a;
}

.resume-title {
  font-size: 36px;
  margin-bottom: 60px;
  color: #1f2d3d;
}

/* GRID */
.resume-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  text-align: left;
}

/* COLUMN */
.resume-column h3 {
  margin-bottom: 30px;
  color: #3b4a5a;
}

/* ITEM */
.resume-item {
  position: relative;
  padding-left: 40px;
  margin-bottom: 35px;
  border-left: 2px solid #e3e3e3;
}

.resume-item::before {
  content: "";
  position: absolute;
  left: -7px;
  top: 5px;
  width: 12px;
  height: 12px;
  background: #2563eb;
  border-radius: 50%;
}

.year {
  font-size: 13px;
  color: #777;
}

.resume-item h4 {
  margin: 6px 0;
  color: #1f2d3d;
}

.org {
  font-weight: 600;
  color: #444;
}

.desc {
  margin-top: 8px;
  color: #555;
  font-size: 14px;
}

/* MOBILE */
@media (max-width: 768px) {
  .resume-grid {
    grid-template-columns: 1fr;
  }
}

.details-container {
  /* use column layout so the title stays at the top and the buttons stay at
     the bottom – this keeps every card the same height and aligns all
     GitHub buttons across siblings */
  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 1.5rem;
  flex: 1;
  background: white;
  border-radius: 2rem;
  border: rgb(53, 53, 53) 0.1rem solid;
  border-color: rgb(163, 163, 163);
  text-align: center;
}

.section-container {
  gap: 4rem;
  height: 80%;
}

.section__pic-container {
  height: 400px;
  width: 400px;
  margin: auto 0;
}

/* ABOUT/RESUME SECTION */

#about {
  position: relative;
}

.experience-sub-title {
  color: rgb(85, 85, 85);
  font-weight: 600;
  font-size: 1.75rem;
  margin-bottom: 2rem;
}

.experience-details-container {
  display: flex;
  justify-content: center;
  flex-direction: column;
}

/* project cards container (reuses about-containers class) */
.about-containers {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  gap: 2rem;
}

/* ensure each card has a reasonable max width so they sit in a row */
.details-container {
  flex: 1 1 220px;
  max-width: 300px;
}

.article-container {
  display: flex;
  text-align: initial;
  flex-wrap: wrap;
  flex-direction: row;
  gap: 2.5rem;
  justify-content: space-around;
}

article {
  display: flex;
  width: 10rem;
  justify-content: space-around;
  gap: 0.5rem;
}

article .icon {
  cursor: default;
}

/* PROJECTS SECTION */

#projects {
  position: relative;
  /* pull section upward so it overlaps the section above */
  margin-top: -60px;
  margin-bottom: 40px;
  z-index: 1;
  padding-top: 80px; /* ensure content doesn’t hide under header */
}

/* optionally give the outer container a card-like background to emphasize overlap */
#projects > .experience-details-container {
  background: white;
  border-radius: 1.5rem;
  padding: 2rem 1.5rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.color-container {
  border-color: rgb(163, 163, 163);
  background: rgb(250, 250, 250);
}

.project-img {
  border-radius: 2rem;
  width: 90%;
  height: 90%;
}

.project-title {
  margin: 1rem;
  color: black;
}

.project-btn {
  color: black;
  border-color: rgb(163, 163, 163);
}

.email-icon {
  height: 2.5rem;
}

/* FOOTER SECTION */

footer {
  height: 26vh;
  margin: 0 1rem;
}

footer p {
  text-align: center;
}

/* MODAL */
.modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.85);
}

/* SLIDER */
.slider-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90%;
}

/* IMAGE & VIDEO */
.slide-content {
  display: none;
  max-width: 85%;
  max-height: 85%;
  border-radius: 12px;
}

/* NAV BUTTONS */
.nav-btn {
  background: none;
  border: none;
  color: white;
  font-size: 40px;
  cursor: pointer;
  padding: 15px;
}

/* CLOSE */
.close {
  position: absolute;
  top: 25px;
  right: 40px;
  font-size: 40px;
  color: white;
  cursor: pointer;
}

/* DOTS */
.dots {
  text-align: center;
  padding-bottom: 20px;
}

.dot {
  height: 12px;
  width: 12px;
  margin: 0 5px;
  background: #bbb;
  border-radius: 50%;
  display: inline-block;
  cursor: pointer;
}

.dot.active {
  background: white;
}


/* ================= MOBILE RESPONSIVE ================= */

@media screen and (max-width: 1024px) {

  /* Profile section stack */
  #profile {
    flex-direction: column;
    height: auto;
    /* gap: 2rem; */
    text-align: center;
  }

  /* Stack About section */
  .section-container {
    flex-direction: column;
    gap: 2rem;
  }

  /* keep project cards in a row on tablets, allow wrapping */
  .about-containers {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  /* Experience cards */
  .article-container {
    justify-content: center;
  }

  /* Reduce section padding */
  section {
    padding: 2rem 1rem;
    margin: 1rem;
  }

  /* Contact height fix */
  #contact {
    height: auto;
  }
}

/* Small Mobile */
@media screen and (max-width: 600px) {

  .title {
    font-size: 2rem;
  }

  .section__text__p2 {
    font-size: 1.2rem;
  }

  .btn {
    width: 100%;
    max-width: 200px;
  }

  .btn-container {
    flex-direction: column;
  }

  nav {
    height: 12vh;
  }
}

@media screen and (max-width: 768px) {
  .section__pic-container {
    width: 250px;
    height: 250px;
    margin: 0 auto 2rem;
  }
  
  nav {
    display: none;
  }

  #hamburger-nav {
    display: flex;
  }

  #profile {
    flex-direction: column;
    text-align: center;
  }

  .section-container {
    flex-direction: column;
  }

  .about-containers {
    flex-direction: column;
    align-items: center;
  }

  section {
    padding: 2rem 1rem;
    margin: 1rem;
  }

  .btn-container {
    flex-direction: column;
  }
}

/* ================= MOBILE BUTTON FIX ================= */

@media screen and (max-width: 768px) {

  /* Center all button containers */
  .btn-container {
    flex-direction: column;
    align-items: center;   /* THIS IS THE IMPORTANT LINE */
    justify-content: center;
  }

  /* Make buttons centered */
  .btn {
    width: 100%;
    max-width: 220px;
    text-align: center;
  }

  /* Center project buttons */
  .project-btn {
    width: 100%;
    max-width: 220px;
  }

  /* Center social icons */
  #socials-container {
    justify-content: center;
  }

  /* Make details container center aligned */
  .details-container {
    text-align: center;
  }
}

/* -------------------- new contact section styles -------------------- */
.contact-section {
  background: #f5f5f5;
  padding: 80px 20px;
}

.contact-wrapper {
  max-width: 1100px;
  margin: 0 auto;
}

.contact-title {
  text-align: center;
  font-size: 32px;
  margin-bottom: 50px;
  color: #333;
}

/* GRID */
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 60px;
  align-items: center;
}

/* LEFT SIDE */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 16px;
}

.icon {
  font-size: 24px;
  color: #f28c52;
  min-width: 28px;
}

.info-item h4 {
  margin: 0;
  font-size: 17px;
  color: #333;
}

.info-item p {
  margin: 3px 0 0;
  color: #666;
  font-size: 14px;
}

/* FORM */
.contact-form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 14px 16px;
  border-radius: 8px;
  border: 1px solid #e5e5e5;
  font-size: 14px;
  background: #fff;
}

.contact-form textarea {
  resize: none;
}

.contact-form button {
  margin-top: 6px;
  padding: 14px;
  border: none;
  border-radius: 8px;
  background: #f28c52;
  color: white;
  font-weight: 600;
  letter-spacing: 1px;
  cursor: pointer;
  transition: 0.3s;
}

.contact-form button:hover {
  background: #e1783f;
}

/* ✅ TABLET */
@media (max-width: 992px) {
  .contact-grid {
    gap: 40px;
  }
}

/* ✅ MOBILE */
@media (max-width: 768px) {
  .contact-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .contact-info {
    align-items: center;
  }

  .info-item {
    justify-content: center;
  }

  .contact-form {
    margin-top: 20px;
  }
}

/* -------------------- skills section styles -------------------- */
.skills-section {
  background: #f7f7f7;
  padding: 90px 20px;
  position: relative;
}

.skills-container {
  max-width: 1100px;
  margin: 0 auto;
  text-align: center;
  position: relative;
}

.skills-subtitle {
  color: #7a7a7a;
}

.skills-title {
  font-size: 38px;
  margin-bottom: 60px;
  color: #1f2d3d;
}

/* CONNECTOR */
.skills-connector {
  width: 2px;
  height: 50px;
  background: #d1d5db;
  margin: 0 auto 30px;
  position: relative;
}

.skills-connector::before,
.skills-connector::after {
  content: "";
  position: absolute;
  top: 50px;
  width: 180px;
  height: 2px;
  background: #d1d5db;
}

.skills-connector::before {
  right: 2px;
}

.skills-connector::after {
  left: 2px;
}

/* GRID */
.skills-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
}

/* CARD */
.skills-card {
  background: #fff;
  border: 1px solid #e3e3e3;
  border-radius: 22px;
  padding: 40px;
  text-align: left;
  position: relative;
}

.skills-card h3 {
  text-align: center;
  margin-bottom: 28px;
  color: #3b4a5a;
}

.skill {
  display: flex;
  justify-content: space-between;
  margin-bottom: 18px;
}

.skill span {
  font-weight: 600;
  color: #1f2d3d;
}

.skill small {
  color: #777;
}

/* MOBILE */
@media (max-width: 768px) {
  .skills-grid {
    grid-template-columns: 1fr;
  }

  .skills-connector {
    display: none;
  }

  .skills-title {
    font-size: 28px;
  }
}